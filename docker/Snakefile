rule all:
    """
    Default top-level target that ensures everything is generated.
    """
    input:
        get_all_outputs

###############################################################################
# Rule: Trim adapters and filter reads (only if trim_fastq=True)
###############################################################################

###############################################################################
# Rule: merge lanes
###############################################################################
# config 'lanes': a CSV (sample, read, lane, file) written by the run command for the samples with
# two or more lane files; the sample sheet then names the merged files by their absolute path.
# The merged files are temporary: Snakemake deletes them once trimming has read them.
lane_reads = ["R1", "R2"] if paired_end else ["R1"]
lane_files = {}                                   # sample -> read -> [(lane, file)]
if config.get("lanes"):
    for row in pd.read_csv(config["lanes"], dtype=str).itertuples():
        lane_files.setdefault(row.sample, {}).setdefault(row.read, []).append((row.lane, row.file))
merged_fastqs = expand(f"{output_prefix}/input_merged/{{sample}}_{{read}}_001.fastq.gz",
                       sample=sorted(lane_files), read=lane_reads)
lane_counts = expand(f"{output_prefix}/logs/lanes/{{sample}}.csv", sample=sorted(lane_files))

rule merge_lanes:
    input:
        lambda wc: [path for read in lane_reads for _, path in sorted(lane_files[wc.sample][read])]
    output:
        fastq = temp(expand(f"{output_prefix}/input_merged/{{{{sample}}}}_{{read}}_001.fastq.gz", read=lane_reads)),
        counts = f"{output_prefix}/logs/lanes/{{sample}}.csv",
    run:
        with open(output.counts, "w") as table:
            table.write("read,lane,reads\n")
            for read, merged in zip(lane_reads, output.fastq):
                with open(merged, "wb") as out:
                    for lane, path in sorted(lane_files[wildcards.sample][read]):
                        with open(path, "rb") as f:
                            shutil.copyfileobj(f, out)          # concatenated gzip files are one valid gzip file
                        lines = subprocess.run(f"gzip -dc '{path}' | wc -l", shell=True, check=True,
                                               capture_output=True, text=True).stdout
                        table.write(f"{read},{lane},{int(lines) // 4}\n")


# This rule is defined conditionally; if trim_fastq==False,
# Snakemake will never see 'rule trim_reads' in the DAG at all.
rule trim_reads:
    input:
        # Our only real "dependency" is the samples CSV, but you could
        # depend on other results if you wanted.
        samples = samples,
        merged = merged_fastqs                    # merged lanes (empty without lanes)
    output:
        trimstats = f"{output_prefix}/{output_prefix}-trimstats.csv",
        trimsamples = f"{output_prefix}/samples.trimmed.csv",
        trimmedreads = sample_fastqfiles_merged if paired_end else sample_fastqfiles_trimmed
        #fastqc = directory(f"{output_prefix}/trimmed/logs/fastqc"),
    threads: threads
    shell:
        """
        {ribomarker_exec} \
            --script trimAdapters -- \
            --samples {input.samples} \
            --threads {threads} \
            --output {output_prefix} \
            --fastqdir {input_dir} 
        """


###############################################################################
# Rule: Collapse reads
###############################################################################
def construct_command_collapse(input, output_prefix, scriptdir, samples):
    cmd = [
        f"{ribomarker_exec}",
        f"--script collapseReads --",
        f"--samples {input.samples}",
        f"--output {output_prefix}",
        f"--threads {threads}",
    ]

    if subsample_amount > 0:
        cmd.append(f"-x {subsample_amount}")
        if collapse == False:
            cmd.append(f"--subsampleonly")

    if trim_fastq == False:
        cmd.append(f"--fastqdir {input_dir}")

    return " \\\n".join(cmd)

rule collapse_reads:
    input:
        samples = samples if not trim_fastq else f"{output_prefix}/samples.trimmed.csv"
    output:
        logfile = f'{output_prefix}/logs/collapse.log',
        collapse_samples = f'{output_prefix}/samples.collapse.csv',
        collapse_reads = collapse_output if collapse == True else sample_fastqfiles_subsampled,
    threads: threads
    shell:
        construct_command_collapse(input, output_prefix, scriptdir, samples)

###############################################################################
# Rule: Map reads to reference databases
###############################################################################

rule map_reads:
    input:
        samples = sample_downstream,        
        fastqfiles = map_input_fastq,
        dbs=dbpaths,
    output:
        logfile=f'{output_prefix}/logs/map.log',
        bamfiles=sample_bamfiles_merged,
    threads: threads
    shell:
        """
        {ribomarker_exec} \
        --script mapReads -- \
        --samples {input.samples} \
        --threads {threads} \
        --output {output_prefix} \
        --dbs {input.dbs} \
        --multimap {multimap} \
        """


###############################################################################
# Rule: Create bedGraph files
###############################################################################


rule bam_to_bedgraph:
    input:
        bam = f"{output_prefix}/alignments/{{sample}}.bam",
        featuretypes = f"{output_prefix}/{output_prefix}-featuretypes.csv",
    output:
        bedgraph = f"{output_prefix}/bedgraph/{{sample}}.bedgraph"
    threads: threads
    shell:
        """
        {ribomarker_exec} \
        --script makeBedgraph -- \
        --step coverage \
        --input {input.bam} \
        --output {output.bedgraph} \
        --featuretypes {input.featuretypes} \
        --keep-types {keep_types}
        """





###############################################################################
# Rule: Parse mappings and generate read counts for feature counting
###############################################################################

rule parse_mappings:
    input:
        samples = sample_downstream,        
        mergedbamfiles=sample_bamfiles_merged,
        bedfile = bedfile,
    output:
        f'{output_prefix}/{output_prefix}-mappingstats.csv',
        f'{output_prefix}/{output_prefix}-readcounts.csv',
        f'{output_prefix}/{output_prefix}-typecounts.csv',
        f'{output_prefix}/{output_prefix}-typelengths.csv',
        f'{output_prefix}/{output_prefix}-featuretypes.csv',
        bamfiles=sample_bamfiles,
        bedgraph_full=bedgraph_full,
    threads: threads
    params:
        unmapped_flag = "--unmapped" if dump_unmapped == True else "",
        remove_mm_flag = "--remove-multimap" if remove_multimap else "",
        remove_as_flag = "--remove-antisense" if remove_antisense else "",
    shell:
        """
        {ribomarker_exec} \
        --script parseMappings -- \
        --samples {input.samples} \
        --threads {threads} \
        --output {output_prefix} \
        --bed {input.bedfile} \
        --bampath {output_prefix}/alignments \
        -q \
        {params.unmapped_flag} \
        {params.remove_mm_flag} \
        {params.remove_as_flag} \
        """

###############################################################################
# Rule: Count RiboSpike reads for additional metrics
###############################################################################
rule count_ribospike:
    input:
        sample_bamfiles,
        samples = sample_downstream,    
    output:
        ribospike_counts = f'{output_prefix}/ribospike/{output_prefix}-ribospike.csv',
        ribospike = directory(f'{output_prefix}/ribospike'),
    threads: threads
    shell:
        """
        {ribomarker_exec} \
        --script countRiboSpike -- \
        -s {input.samples} \
        -o {output_prefix} \
        --threads {threads} \
        --bampath {output_prefix}/alignments \
        """

        
       
       
