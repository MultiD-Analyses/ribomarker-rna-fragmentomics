###############################################################################
# Functions to dynamically build up output
###############################################################################

def get_all_outputs(wildcards):
    """
    All final targets of 'rule all': the pipeline outputs plus, with qc_report: True,
    the QC outputs (not for trim_only runs, which have nothing to map).
    """
    targets = get_pipeline_outputs(wildcards)
    if qc_report and not trim_only:
        targets += [f"{output_prefix}/qc/qc_metrics.json", f"{output_prefix}/qc/report_technical.html"]
    return targets


def get_pipeline_outputs(wildcards):
    """
    Returns a list of all pipeline output targets (everything except the QC outputs).
    Conditionally includes the trimming output if trim_fastq is True.
    """
    targets = []

    # If trimming is on, include the trimstats CSV
    if trim_fastq:
        targets.append(f"{output_prefix}/{output_prefix}-trimstats.csv")
        targets.append(f"{output_prefix}/samples.trimmed.csv")
        if paired_end:
            targets.extend(sample_fastqfiles_merged)
        else:
            targets.extend(sample_fastqfiles_trimmed)

    if trim_only == True:
        return targets

    if collapse == True:
        targets.append(f"{output_prefix}/samples.collapse.csv")
        targets.extend(sample_fastqfiles_collapsed)

    if subsample_amount > 0:
        targets.append(f"{output_prefix}/samples.collapse.csv")
        targets.extend(sample_fastqfiles_subsampled)


    # Reads per lane of the samples whose lanes were merged
    targets.extend(lane_counts)

    # Always include the final BAM files
    targets.extend(sample_bamfiles_merged)

    # Add parse_mappings outputs
    targets.append(f"{output_prefix}/{output_prefix}-mappingstats.csv")
    targets.append(f"{output_prefix}/{output_prefix}-readcounts.csv")
    targets.append(f"{output_prefix}/{output_prefix}-typecounts.csv")
    targets.append(f"{output_prefix}/{output_prefix}-typelengths.csv")
    targets.append(f"{output_prefix}/{output_prefix}-featuretypes.csv")
    # The gene table needs remove-at-source counts: collapseGenes.py stops on _multimap/_antisense rows
    if remove_multimap and remove_antisense:
        targets.append(f"{output_prefix}/{output_prefix}-genecounts.csv")
        targets.append(f"{output_prefix}/{output_prefix}-genelengths.csv")


    # Add bam files from parse_mappings
    targets.extend(sample_bamfiles)

    # Add ribospike outputs if True
    if count_ribospike:
        targets.append(f"{output_prefix}/ribospike/{output_prefix}-ribospike.csv")
        targets.append(directory(f"{output_prefix}/ribospike"))

    targets.extend(sample_bedgraphfiles)
    targets.extend(expand(f"{output_prefix}/bedgraph_full/{{sample}}.bedgraph", sample=sample_ids))
    

    # You can append other final targets here as needed.
    return targets

###############################################################################
# Generate all bamfiles
###############################################################################
def parse_sample_ids(path):
    """
    Example function to read a sample CSV and return a list of sample IDs.
    Adjust parsing logic to match your CSV format.
    """
    if paired_end == True:
        sampleinfo = pd.read_csv(path, header=None, names=["sample", "condition", "fastq", "fastq2"])
    else:
        sampleinfo = pd.read_csv(path, header=None, names=["sample", "condition", "fastq"])
    sample_ids = sampleinfo["sample"].tolist()

    return sample_ids

# If that file doesn't exist yet, it might get generated by an upstream rule.
# The simplest approach is to do a "best effort" parse or fallback.
sample_ids = []
if os.path.exists(samples):
    sample_ids = parse_sample_ids(samples)
else:
    # You could also leave it empty until it is created, or handle it differently.
    pass
# Create a global list of expected bam files
sample_bamfiles_merged = expand(
    f"{output_prefix}/alignments/{{sample}}.merged.bam", 
    sample=sample_ids
)

sample_bamfiles = expand(
    f"{output_prefix}/alignments/{{sample}}.bam", 
    sample=sample_ids
)

sample_bedgraphfiles = expand(
    f"{output_prefix}/bedgraph/{{sample}}.bedgraph",
    sample=sample_ids
)

bedgraph_full = expand(
    f"{output_prefix}/bedgraph_full/{{sample}}.bedgraph",
    sample=sample_ids
)

sample_fastqfiles_trimmed = expand(
    f"{output_prefix}/trimmed/{{sample}}.trimmed.fq.gz", 
    sample=sample_ids
)

sample_fastqfiles_collapsed = expand(
    f"{output_prefix}/collapse/{{sample}}.collapse.fa", 
    sample=sample_ids
)

sample_fastqfiles_merged = expand(
    f"{output_prefix}/trimmed/{{sample}}.merged.fq.gz", 
    sample=sample_ids
)

sample_fastqfiles_subsampled = expand(
    f"{output_prefix}/subsample/{{sample}}.subsample.fq.gz", 
    sample=sample_ids
)

if collapse == True:
    sample_downstream = f"{output_prefix}/samples.collapse.csv"
    map_input_fastq = sample_fastqfiles_collapsed
    collapse_output = sample_fastqfiles_collapsed
elif collapse == False:
    if subsample_amount > 0:
        sample_downstream = f"{output_prefix}/samples.collapse.csv"
        map_input_fastq = sample_fastqfiles_subsampled
        collapse_output = sample_fastqfiles_subsampled
    else:
        if trim_fastq == True:
            sample_downstream = f"{output_prefix}/samples.trimmed.csv"
            if paired_end:
                map_input_fastq = sample_fastqfiles_merged
            else:
                map_input_fastq = sample_fastqfiles_trimmed
        else:
            sample_downstream = samples
            print(f"Need to process fastq files. Exiting.")
            exit(1)

