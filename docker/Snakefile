import os
import shutil
import sys
import pandas as pd
import yaml
from pathlib import Path

###############################################################################
# Load configuration from YAML file
###############################################################################

# Base input directory (local or container)
input_dir = config.get("input_dir", ".")


dbdir = config.get("dbdir", None)

###############################################################################
# Get sample file name from config
###############################################################################

samples = config.get("samples", "samples.csv")  # Default to samples.csv in input directory
samples = os.path.join(input_dir, samples)  # Adjust path for Docker

###############################################################################
# Load required parameters from config
###############################################################################

output_prefix = config.get("output_prefix", "example")  # Prefix for output files
species = config.get("species", "human2")  # Species for database selection
count_ribospike = config.get("count_ribospike", True) # Whether or not to count RiboSpike hits
qc_report = config.get("qc_report", True)  # QC collector + technical report (docker/scripts/qcCollect.py, qcReport.py)

remove_multimap  = config.get("remove_multimap", True)
remove_antisense = config.get("remove_antisense", True)

_paired_end_config = config.get("paired_end", None)
if _paired_end_config is not None:
    paired_end = _paired_end_config
elif os.path.exists(samples):
    with open(samples) as _f:
        paired_end = len(_f.readline().strip().split(',')) == 4
else:
    paired_end = False
PIPELINE_DIR = Path(workflow.basedir)  # directory containing the Snakefile
scriptdir = PIPELINE_DIR / "scripts"
ribomarker_exec = f"python {os.path.join(scriptdir, 'main.py')}"   # how the rules start the pipeline scripts
sys.path.insert(0, str(scriptdir))
from dbPaths import find_dbpaths  # which dbpaths file to read
import dbPaths
import refTables                  # RNA class tables (release 0.3.0)
import removedKeys                # keys removed in 0.4.0
import mapSchedule                # order file and mapping schedule (0.4.0)

# Keys removed in 0.4.0 (collapse, subsample_reads, trim_fastq, trim_only, dump_unmapped): the old
# default value is accepted with a warning, any other value stops the run
_removed_warnings, _removed_errors = removedKeys.check_removed_keys(config)
for _warning in _removed_warnings:
    print(f"WARNING: {_warning}", file=sys.stderr)
if _removed_errors:
    raise ValueError("settings removed in release 0.4.0:\n  " + "\n  ".join(_removed_errors))

if dbdir is None:
    raise ValueError(
        "dbdir must be set: in-pipeline database building (buildDB) was removed. "
        "Build assets with buildDB/buildDB_v1.py and point dbdir at them."
    )
dbpaths = find_dbpaths(dbdir, species)
bedfile = os.path.join(dbdir, f"{species}.bed")

# Mapping schedule, order file and RNA class table. The order file (config key tiers; the run command's --tiers;
# release 0.4.0, mapSchedule.py) names the references of the folder in the order to use; without it, the order of
# <species>.dbpaths.csv. The class table: config key rna_classes (--rna-classes) > the references folder's own
# <species>.rna_classes.tsv > docker/tables/<species>.rna_classes.tsv > docker/tables/default.rna_classes.tsv.
# The schedule, the order in effect, its dbpaths lines and the class table are written into <run>/tables/ (rule
# run_tables); the steps read those.
tiers_file = config.get("tiers", None)
passes_file = config.get("passes", None)       # pass settings (0.4.0; experimental)
for _key, _file in (("tiers", tiers_file), ("passes", passes_file)):
    if _file and not os.path.exists(_file):
        raise ValueError(f"{_key}: file not found: {_file}")
schedule_rows, _left_out, _problems, _warnings = mapSchedule.resolve(dbpaths, species, config.get("multimap", 100),
                                                                     tiers_file, count_ribospike, passes_file)
if _problems:
    raise ValueError(f"tiers/passes: {tiers_file or passes_file or dbpaths} cannot be used: " + "; ".join(_problems))
if _left_out:
    print(f"WARNING: tiers: {tiers_file} leaves out {', '.join(_left_out)}; not used in this run", file=sys.stderr)
for _warning in _warnings:
    print(f"WARNING: passes: {_warning}", file=sys.stderr)
order_names = mapSchedule.order_in_effect(dbpaths, species, tiers_file)     # for order.tsv, tiers.csv, the printout
rna_classes = refTables.find_table(species, dbdir, config.get("rna_classes", None))
class_table = refTables.ClassTable(rna_classes, species)    # a broken table stops here, before anything runs
_unknown_tiers = class_table.unknown_tiers(row["reference"] for row in schedule_rows)
if _unknown_tiers:
    print(f"WARNING: the RNA class table {rna_classes} names tiers that the tier list does not have: "
          f"{', '.join(_unknown_tiers)}{class_table.split_tier_note(_unknown_tiers)}", file=sys.stderr)
for _warning in class_table.obsolete_rows():
    print(f"WARNING: {_warning}", file=sys.stderr)
# Gene symbols and miRBase names (3f): docker/tables/<species>.gene_symbols.tsv when it exists; parseMappings fills
# the columns only if the table was built for this references BED
gene_symbols = refTables.gene_symbols_table(species)

###############################################################################
# Load optional parameters from config
###############################################################################

multimap = config.get("multimap", 100)  # Maximum allowed multimapped reads
threads = config.get("threads", 20)  # Number of processing threads
# Coverage filter: 'all' or comma-separated RNA class ids, no spaces. keep_types is its name before 0.3.0 (still
# accepted, with a warning); old class names are translated with the class table (refTables.translate_keep).
if "keep_types" in config:
    print("WARNING: config key keep_types is called keep_classes since 0.3.0"
          + ("; keep_classes is used" if "keep_classes" in config else "; its value is used"))
for _old, _new in refTables.renamed_keep(config.get("keep_classes", config.get("keep_types", "all")), class_table):
    print(f"WARNING: keep_classes: {_old} is a name before 0.3.0; the RNA class {_new} is kept (all of it)",
          file=sys.stderr)
keep_classes = refTables.translate_keep(config.get("keep_classes", config.get("keep_types", "all")), class_table)
###############################################################################
###############################################################################
###############################################################################

print("-" * 50)
print(f"species: {species}")
print(f"output_prefix: {output_prefix}")
print(f"multimap: {multimap}")
print(f"threads: {threads}")
print(f"paired_end: {paired_end}")
print(f"count_ribospike: {count_ribospike}")
print(f"qc_report: {qc_report}")
print(f"tiers: {tiers_file or dbpaths}")
if passes_file:
    print(f"passes: {passes_file}")
print(f"rna_classes: {rna_classes}")
print("-" * 50)
if os.environ.get("RIBOMARKER_RUN") != "1":    # run (runCommand.py) prints it before it starts Snakemake
    print(mapSchedule.render(schedule_rows, tiers_file, _left_out, passes_file, order_names))
    print("-" * 50)

###############################################################################
# Functions to dynamically build up output
###############################################################################

def get_all_outputs(wildcards):
    """
    All final targets of 'rule all': the pipeline outputs plus, with qc_report: True,
    the QC outputs.
    """
    targets = get_pipeline_outputs(wildcards)
    if qc_report:
        targets += [f"{output_prefix}/qc/qc_metrics.json", f"{output_prefix}/qc/report_technical.html"]
    return targets


def get_pipeline_outputs(wildcards):
    """
    Returns a list of all pipeline output targets (everything except the QC outputs).
    """
    targets = []

    # Trimming: the trimstats CSV, the sample sheet of the trimmed reads and the reads
    targets.append(f"{output_prefix}/{output_prefix}-trimstats.csv")
    targets.append(f"{output_prefix}/samples.trimmed.csv")
    if paired_end:
        targets.extend(sample_fastqfiles_merged)
    else:
        targets.extend(sample_fastqfiles_trimmed)


    # Always include the final BAM files
    targets.extend(sample_bamfiles_merged)

    # The tier list and class table of the run (provenance)
    targets.append(f"{output_prefix}/tables/rna_classes.tsv")
    targets.append(f"{output_prefix}/tables/tiers.csv")
    targets.append(f"{output_prefix}/tables/contig_tiers.tsv")
    targets.append(f"{output_prefix}/tables/order.tsv")
    targets.append(f"{output_prefix}/tables/schedule.tsv")
    if passes_file:
        targets.append(f"{output_prefix}/tables/passes.tsv")

    # Add parse_mappings outputs
    targets.append(f"{output_prefix}/{output_prefix}-mappingstats.csv")
    targets.append(f"{output_prefix}/{output_prefix}-readcounts.csv")
    targets.append(f"{output_prefix}/{output_prefix}-classcounts.csv")
    targets.append(f"{output_prefix}/{output_prefix}-classlengths.csv")
    targets.append(f"{output_prefix}/{output_prefix}-featureclasses.csv")
    # The gene table needs remove-at-source counts: collapseGenes.py stops on _multimap/_antisense rows
    if remove_multimap and remove_antisense:
        targets.append(f"{output_prefix}/{output_prefix}-genecounts.csv")
        targets.append(f"{output_prefix}/{output_prefix}-genelengths.csv")


    # Add bam files from parse_mappings
    targets.extend(sample_bamfiles)

    # Add ribospike outputs if True
    if count_ribospike:
        targets.append(f"{output_prefix}/ribospike/{output_prefix}-ribospike.csv")
        targets.append(directory(f"{output_prefix}/ribospike"))

    targets.extend(sample_bedgraphfiles)
    targets.extend(bedgraph_full)
    

    # You can append other final targets here as needed.
    return targets

###############################################################################
# Generate all bamfiles
###############################################################################
def parse_sample_ids(path):
    """
    Example function to read a sample CSV and return a list of sample IDs.
    Adjust parsing logic to match your CSV format.
    """
    if paired_end == True:
        sampleinfo = pd.read_csv(path, header=None, names=["sample", "condition", "fastq", "fastq2"])
    else:
        sampleinfo = pd.read_csv(path, header=None, names=["sample", "condition", "fastq"])
    sample_ids = sampleinfo["sample"].tolist()

    return sample_ids

sample_ids = parse_sample_ids(samples) if os.path.exists(samples) else []   # the sheet may not exist yet
# Create a global list of expected bam files
sample_bamfiles_merged = expand(
    f"{output_prefix}/alignments/{{sample}}.merged.bam", 
    sample=sample_ids
)

sample_bamfiles = expand(
    f"{output_prefix}/alignments/{{sample}}.bam", 
    sample=sample_ids
)

sample_bedgraphfiles = expand(
    f"{output_prefix}/bedgraph/{{sample}}.bedgraph",
    sample=sample_ids
)

bedgraph_full = expand(
    f"{output_prefix}/bedgraph_full/{{sample}}.bedgraph",
    sample=sample_ids
)

sample_fastqfiles_trimmed = expand(
    f"{output_prefix}/trimmed/{{sample}}.trimmed.fq.gz", 
    sample=sample_ids
)

sample_fastqfiles_merged = expand(
    f"{output_prefix}/trimmed/{{sample}}.merged.fq.gz", 
    sample=sample_ids
)

# The mapping step reads the trimmed (paired-end: merged) reads
sample_downstream = f"{output_prefix}/samples.trimmed.csv"
map_input_fastq = sample_fastqfiles_merged if paired_end else sample_fastqfiles_trimmed

###############################################################################
# Rule: all
###############################################################################

rule all:
    """
    Default top-level target that ensures everything is generated.
    """
    input:
        get_all_outputs

###############################################################################
# Rule: Trim adapters and filter reads
###############################################################################

rule trim_reads:
    input:
        samples = samples,
    output:
        trimstats = f"{output_prefix}/{output_prefix}-trimstats.csv",
        trimsamples = f"{output_prefix}/samples.trimmed.csv",
        trimmedreads = sample_fastqfiles_merged if paired_end else sample_fastqfiles_trimmed
    threads: threads
    shell:
        """
        {ribomarker_exec} \
            --script trimAdapters -- \
            --samples {input.samples} \
            --threads {threads} \
            --output {output_prefix} \
            --fastqdir {input_dir} 
        """


###############################################################################
# Rule: Map reads to reference databases
###############################################################################

rule map_reads:
    input:
        samples = sample_downstream,        
        fastqfiles = map_input_fastq,
        dbs=dbpaths,
        schedule = f"{output_prefix}/tables/schedule.tsv",
    output:
        logfile=f'{output_prefix}/logs/map.log',
        bamfiles=sample_bamfiles_merged,
    params:
        xp = "--xp" if passes_file else "",     # with --passes: XP:i:<pass> on the mapped records
    threads: threads
    shell:
        """
        {ribomarker_exec} \
        --script mapReads -- \
        --samples {input.samples} \
        --threads {threads} \
        --output {output_prefix} \
        --dbs {input.dbs} \
        --schedule {input.schedule} {params.xp}
        """


###############################################################################
# Rule: Create bedGraph files
###############################################################################


rule bam_to_bedgraph:
    input:
        bam = f"{output_prefix}/alignments/{{sample}}.bam",
        featureclasses = f"{output_prefix}/{output_prefix}-featureclasses.csv",
    output:
        bedgraph = f"{output_prefix}/bedgraph/{{sample}}.bedgraph"
    threads: threads
    shell:
        """
        {ribomarker_exec} \
        --script makeBedgraph -- \
        --input {input.bam} \
        --output {output.bedgraph} \
        --featureclasses {input.featureclasses} \
        --keep-classes {keep_classes:q}
        """





###############################################################################
# Rule: the mapping schedule, the order in effect, the tier list and the RNA class table of the run
###############################################################################
# The steps read these files, so a rerun of a step uses the tables the run started with; qcCollect records
# the sources (run_config.yaml: rna_classes, tiers) and checksums (prov.class_tables).

rule run_tables:
    input:
        dbpaths = dbpaths,
        order = [tiers_file] if tiers_file else [],
        passes = [passes_file] if passes_file else [],
    output:
        tiers = f"{output_prefix}/tables/tiers.csv",
        contig_tiers = f"{output_prefix}/tables/contig_tiers.tsv",
        order = f"{output_prefix}/tables/order.tsv",
        schedule = f"{output_prefix}/tables/schedule.tsv",
    run:
        mapSchedule.write_schedule(schedule_rows, output.schedule)
        mapSchedule.write_order(schedule_rows, output.order, order_names)
        mapSchedule.write_tiers(schedule_rows, input.dbpaths, species, output.tiers, order_names)   # dbpaths lines in effect
        # which tier each reference sequence belongs to (bowtie-inspect -n): reads on UniVec contigs without a
        # feature become the class UniVec in parseMappings (3g)
        dbPaths.write_contig_tiers(dbPaths.read_dbpaths(output.tiers, dbdir), species, output.contig_tiers)


# The RNA class table of the run: its own rule, because the class table does not affect mapping (map_reads reads
# tables/schedule.tsv of run_tables; release 0.4.0)
rule run_classes:
    input:
        rna_classes = rna_classes,
    output:
        rna_classes = f"{output_prefix}/tables/rna_classes.tsv",
    run:
        shutil.copyfile(input.rna_classes, output.rna_classes)


# The pass settings as given (only with --passes / passes:; the sources and checksums are in qcCollect's provenance)
rule run_passes:
    input:
        passes = passes_file or [],
    output:
        passes = f"{output_prefix}/tables/passes.tsv",
    run:
        shutil.copyfile(input.passes, output.passes)


###############################################################################
# Rule: Parse mappings and generate read counts for feature counting
###############################################################################

rule parse_mappings:
    input:
        samples = sample_downstream,        
        mergedbamfiles=sample_bamfiles_merged,
        bedfile = bedfile,
        rna_classes = f"{output_prefix}/tables/rna_classes.tsv",
        contig_tiers = f"{output_prefix}/tables/contig_tiers.tsv",
        gene_symbols = gene_symbols or [],
    output:
        f'{output_prefix}/{output_prefix}-mappingstats.csv',
        f'{output_prefix}/{output_prefix}-readcounts.csv',
        f'{output_prefix}/{output_prefix}-classcounts.csv',
        f'{output_prefix}/{output_prefix}-classlengths.csv',
        f'{output_prefix}/{output_prefix}-featureclasses.csv',
        bamfiles=sample_bamfiles,
        bedgraph_full=bedgraph_full,
    threads: threads
    params:
        remove_mm_flag = "--remove-multimap" if remove_multimap else "",
        remove_as_flag = "--remove-antisense" if remove_antisense else "",
        symbols_flag = f"--gene-symbols {gene_symbols}" if gene_symbols else "",
    shell:
        """
        {ribomarker_exec} \
        --script parseMappings -- \
        --samples {input.samples} \
        --threads {threads} \
        --output {output_prefix} \
        --bed {input.bedfile} \
        --rna-classes {input.rna_classes} \
        --contig-tiers {input.contig_tiers} \
        {params.symbols_flag} \
        --bampath {output_prefix}/alignments \
        {params.remove_mm_flag} \
        {params.remove_as_flag} \
        """

###############################################################################
# Rule: Count RiboSpike reads for additional metrics
###############################################################################
rule count_ribospike:
    input:
        sample_bamfiles,
        samples = sample_downstream,    
    output:
        ribospike_counts = f'{output_prefix}/ribospike/{output_prefix}-ribospike.csv',
        ribospike = directory(f'{output_prefix}/ribospike'),
    threads: threads
    shell:
        """
        {ribomarker_exec} \
        --script countRiboSpike -- \
        -s {input.samples} \
        -o {output_prefix} \
        --threads {threads} \
        --bampath {output_prefix}/alignments \
        """

        
       
       
###############################################################################
# Rule: Collapse per-feature counts to a gene-level, mature-exonic matrix
###############################################################################
rule collapse_genes:
    input:
        readcounts   = f"{output_prefix}/{output_prefix}-readcounts.csv",
        featureclasses = f"{output_prefix}/{output_prefix}-featureclasses.csv",
        rna_classes = f"{output_prefix}/tables/rna_classes.tsv",
    output:
        f"{output_prefix}/{output_prefix}-genecounts.csv",
        f"{output_prefix}/{output_prefix}-genelengths.csv",
    shell:
        """
        {ribomarker_exec} \
        --script collapseGenes -- \
        --readcounts {input.readcounts} \
        --featureclasses {input.featureclasses} \
        --rna-classes {input.rna_classes} \
        --output {output_prefix}/{output_prefix}
        """


###############################################################################
# Rule: QC collector
###############################################################################
# Reads the outputs of all other rules and writes qc_metrics.json and metrics_long.tsv.
# run_config.yaml records the configuration as the pipeline resolved it (paired_end may
# have been inferred from the sample sheet), so the collector sees the same values.

rule qc_collect:
    input:
        get_pipeline_outputs
    output:
        metrics = f"{output_prefix}/qc/qc_metrics.json",
        long = f"{output_prefix}/qc/metrics_long.tsv",
        run_config = f"{output_prefix}/qc/run_config.yaml",
    run:
        resolved = dict(config)
        resolved.update({"input_dir": input_dir, "dbdir": dbdir, "output_prefix": output_prefix,
                         "species": species, "paired_end": bool(paired_end),
                         "samples": config.get("samples", "samples.csv"),
                         "remove_multimap": remove_multimap, "remove_antisense": remove_antisense,
                         "count_ribospike": count_ribospike,
                         "rna_classes": rna_classes, "tiers": tiers_file or dbpaths,   # sources; tables/
                         "gene_symbols": gene_symbols})
        for key in ("host_input_dir", "host_assets_dir"):   # Docker launcher only: host paths of the user,
            resolved.pop(key, None)                          # not needed by the collector, kept out of qc/
        for key in removedKeys.REMOVED_KEYS:                 # removed in 0.4.0 (warned about above)
            resolved.pop(key, None)
        with open(output.run_config, "w") as f:
            yaml.safe_dump(resolved, f, sort_keys=False)
        shell("{ribomarker_exec} --script qcCollect -- --output {output_prefix} --config {output.run_config} "
              "--qc-dir {PIPELINE_DIR}/qc --version-file {PIPELINE_DIR}/VERSION")

###############################################################################
# Rule: technical QC report (MultiQC)
###############################################################################

rule qc_report:
    input:
        f"{output_prefix}/qc/qc_metrics.json"
    output:
        f"{output_prefix}/qc/report_technical.html"
    params:
        # report title: set by the run command; the config route keeps the run folder name
        title = f'--title "{config["report_title"]}"' if config.get("report_title") else ""
    shell:
        """
        {ribomarker_exec} \
        --script qcReport -- \
        --output {output_prefix} \
        --qc-dir {PIPELINE_DIR}/qc {params.title}
        """
