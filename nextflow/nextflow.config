// nextflow/nextflow.config
params {
    input                          = null
    outdir                         = 'results'
    run_id                         = 'ribomarker'
    species                        = 'human'
    assets_dir                     = null
    multimap                       = 100
    circularization_clip_5prime_nt = 1
    adapter_3prime_seq             = 'TGGAATTCTCGGGTGCCAAGG'
    min_length                     = 15
    max_length                     = 100
    align_mode                     = 'standard'

    // Resource ceilings & HPC scheduler configuration
    max_cpus                       = 32
    max_memory                     = '128.GB'
    max_time                       = '48.h'
    cluster_queue                  = null
    cluster_options                = null
    container_image                = 'dockermultid/ribomarker-rna-fragmentomics:0.3.0'
}

process {
    executor       = 'local'
    cpus           = { check_max( 4 * task.attempt, 'cpus' ) }
    memory         = { check_max( 8.GB * task.attempt, 'memory' ) }
    time           = { check_max( 4.h  * task.attempt, 'time' ) }
    queue          = { params.cluster_queue ?: null }
    clusterOptions = { params.cluster_options ?: null }

    errorStrategy  = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries     = 2
    maxErrors      = '-1'

    withLabel: 'process_low' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 6.h * task.attempt, 'time' ) }
    }
    withLabel: 'process_high' {
        cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h * task.attempt, 'time' ) }
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor       = 'slurm'
        executor.queueSize     = 50
        executor.submitRateLimit = '10 sec'
    }
    pbs {
        process.executor       = 'pbs'
        executor.queueSize     = 50
    }
    pbspro {
        process.executor       = 'pbspro'
        executor.queueSize     = 50
    }
    sge {
        process.executor       = 'sge'
        process.penv           = 'smp'
        executor.queueSize     = 50
    }
    lsf {
        process.executor       = 'lsf'
        executor.queueSize     = 50
    }
    docker {
        process.container      = params.container_image
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        apptainer.enabled      = false
        env.PATH               = '/opt/conda/envs/ribomarker/bin:$PATH'
    }
    singularity {
        process.container      = params.container_image
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        env.PATH               = '/opt/conda/envs/ribomarker/bin:$PATH'
    }
    apptainer {
        process.container      = params.container_image
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        env.PATH               = '/opt/conda/envs/ribomarker/bin:$PATH'
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            return obj
        }
    }
}
